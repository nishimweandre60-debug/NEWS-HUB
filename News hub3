// NEWSLETTER

function subscribe(event) {

    event.preventDefault();

    const email =
        document.getElementById("email").value;

    if (email) {

        alert(
            "Murakoze! " +
            email +
            " was subscribed successfully."
        );

        document.getElementById("email").value = "";

    }

}
